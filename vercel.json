{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/index-fr.html", "destination": "/fr", "permanent": true }
  ],
  "rewrites": [
    { "source": "/fr", "destination": "/index-fr.html" },
    { "source": "/career", "destination": "/career.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/menu", "destination": "/menu.html" },
    { "source": "/find-us", "destination": "/find-us.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/masson-location", "destination": "/masson-location.html" },
    { "source": "/wellington-location", "destination": "/wellington-location.html" },
    { "source": "/career-fr", "destination": "/career-fr.html" },
    { "source": "/about-fr", "destination": "/about-fr.html" },
    { "source": "/menu-fr", "destination": "/menu-fr.html" },
    { "source": "/find-us-fr", "destination": "/find-us-fr.html" },
    { "source": "/contact-fr", "destination": "/contact-fr.html" },
    { "source": "/privacy-fr", "destination": "/privacy-fr.html" }
  ]
}
