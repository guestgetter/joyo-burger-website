# JOYO Burger Website - Clean URL Configuration
RewriteEngine On

# Canonical host: force www + https (single hop)
RewriteCond %{HTTP_HOST} !^www\.joyoburger\.com$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^ https://www.joyoburger.com%{REQUEST_URI} [R=301,L]

# Redirect .html URLs to clean URLs
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Internal rewrites for clean URLs - SPECIFIC RULES FIRST

# French pages (must come before general rule)
RewriteRule ^menu-fr$ /menu-fr.html [L]
RewriteRule ^about-fr$ /about-fr.html [L]
RewriteRule ^contact-fr$ /contact-fr.html [L]
RewriteRule ^career-fr$ /career-fr.html [L]
RewriteRule ^find-us-fr$ /find-us-fr.html [L]
RewriteRule ^privacy-fr$ /privacy-fr.html [L]

# Special language handling
RewriteRule ^fr/?$ /index-fr.html [L]

# English pages
RewriteRule ^menu$ /menu.html [L]
RewriteRule ^about$ /about.html [L]
RewriteRule ^contact$ /contact.html [L]
RewriteRule ^career$ /career.html [L]
RewriteRule ^find-us$ /find-us.html [L]
RewriteRule ^privacy$ /privacy.html [L]
RewriteRule ^blog$ /blog.html [L]

# General fallback for other clean URLs (LAST)
RewriteRule ^([^/.]+)$ /$1.html [L]

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
</IfModule>

# Cache settings
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresDefault "access plus 1 week"
</IfModule>

# Error pages
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# Prevent directory listing
Options -Indexes

# Set default charset
AddDefaultCharset UTF-8 